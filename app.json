{
  "expo": {
    "name": "di-delivery-app",
    "slug": "di-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/imgPizza.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davi.didelivery"
    },
    "android": {
      "package": "com.davi.didelivery",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/imgPizza.png",
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "favicon": "./app/assets/imgPizza.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/imgPizza.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5be4a446-e71f-4aa8-8c74-daee0d7abb05"
      }
    }
  }
}
